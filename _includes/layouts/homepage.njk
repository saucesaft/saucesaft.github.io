        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

<div class="window" id="map">
  <div class="title-bar">
    <button aria-label="Close" class="close"></button>
    <h1 class="title"> page visits </h1>
    <button aria-label="Resize" class="resize"></button>
  </div>
  <div class="separator"></div>

  <div class="window-pane">
    <script type='text/javascript' id='mapmyvisitors' src='https://mapmyvisitors.com/map.js?cl=00bd80&w=a&t=n&d=BNdVFgnU-gV5-NmJ8ZUGTS86FLv0A939QT3rpGypSpI&co=ffffff&cmo=000000&cmn=0a8db2'></script>
  </div>
</div>