---
layout: layouts/base.njk
templateClass: tmpl-home
---

<div class="window">
  <div class="title-bar">
    <button aria-label="Close" class="close"></button>
    <h1 class="title"> {{ title }} </h1>
    <button aria-label="Resize" class="resize"></button>
  </div>
  <div class="separator"></div>

  <div class="window-pane">
    {{ content | wikitransform(page, collections.all) | safe }}
  </div>
</div>

<div id="projects">
  <div class="column column-1">
    {% for project in projects.list %}
      {% if loop.index0 % 3 == 0 %}
        <div class="window project-item" data-index="{{ loop.index0 }}">
          {% if project.wikiPath %}
          <a href="{{ project.wikiPath }}" style="text-decoration: none; color: inherit; cursor: default;">
          {% endif %}
            <div class="title-bar">
              <button aria-label="Close" class="close"></button>
              <h1 class="title" {% if project.wikiPath %}style="text-decoration: underline; text-decoration-thickness: 2px; cursor: pointer;"{% endif %}> {{ project.title }} </h1>
              <button aria-label="Resize" class="resize"></button>
            </div>
          {% if project.wikiPath %}
          </a>
          {% endif %}
          <div class="separator"></div>

          {% if project.media %}
            {% if project.wikiPath %}
            <a href="{{ project.wikiPath }}" style="cursor: pointer;">
            {% endif %}
              {% if project.media | lower | endsWith(".mp4") %}
                {% set size = project.media | videoSize %}
                <div class="video-frame">
                <video
                  style="max-width:100%;{% if size %} aspect-ratio: {{ size.width }} / {{ size.height }};{% endif %}"
                  {% if size %}width="{{ size.width }}" height="{{ size.height }}"{% endif %}
                  data-src="{{ project.media }}"
                  preload="none"
                  autoplay
                  loop
                  muted
                  playsinline
                  class="project-media"
                ></video>
                <span class="video-message video-loading" aria-hidden="true">loading<span class="dots"></span></span>
                <span class="video-message video-nojs">turn on JavaScript to see this video</span>
                </div>
              {% else %}
                <img
                  style="max-width:100%;"
                  src="{{ project.media }}"
                  alt="{{ project.title }}"
                  class="project-media"
                />
              {% endif %}
            {% if project.wikiPath %}
            </a>
            {% endif %}
          {% endif %}

          <div class="window-pane">
            {% if project.script %}
              {{ project.script | wikitransform(page, collections.all) | safe }}
            {% else %}
              {{ project.description | wikitransform(page, collections.all) | safe }}
            {% endif %}
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>

