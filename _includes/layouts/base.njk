  <body>

    <script type="text/javascript">
      
      function isElementOverflowing(element) {
        
        // get the width of the element
        var width = element.clientWidth;
        // get the scroll width (the full content width)
        var scrollWidth = element.scrollWidth;
        
        // if the scroll width is greater than the visible width, it's overflowing
        return scrollWidth > width;
      }

      function wrapContentsInMarquee(element) {
        var marquee = document.createElement('marquee');
        var contents = element.innerText;

        marquee.innerText = contents;
        element.innerHTML = '';
        element.appendChild(marquee);
      }

      document.addEventListener("DOMContentLoaded", function(e) {
        let titles = document.getElementsByClassName("title");

        for (let i = 0; i < titles.length; i++) {
          if (isElementOverflowing(titles[i])) {
            wrapContentsInMarquee(titles[i]);
          }
        }

        // Two-column masonry layout for tablets
        const projectsContainer = document.getElementById('projects');
        if (!projectsContainer) return;

        // Store original column assignments
        const originalColumns = new Map();
        const allProjects = Array.from(projectsContainer.querySelectorAll('.project-item'));
        allProjects.forEach(project => {
          originalColumns.set(project, project.parentElement);
        });

        function redistributeProjects() {
          const width = window.innerWidth;
          const col1 = projectsContainer.querySelector('.column-1');
          const col2 = projectsContainer.querySelector('.column-2');
          const col3 = projectsContainer.querySelector('.column-3');

          if (!col1 || !col2 || !col3) return;

          // Tablet layout (736px - 1200px): Redistribute into 2 columns
          if (width >= 736 && width <= 1200) {
            // Get all projects and sort by data-index
            const sorted = Array.from(allProjects).sort((a, b) => {
              return parseInt(a.dataset.index) - parseInt(b.dataset.index);
            });

            // Clear columns
            col1.innerHTML = '';
            col2.innerHTML = '';
            col3.innerHTML = '';
            col3.style.display = 'none';

            // Distribute: even indices to col1, odd to col2
            sorted.forEach((project, idx) => {
              if (idx % 2 === 0) {
                col1.appendChild(project);
              } else {
                col2.appendChild(project);
              }
            });
          }
          // Desktop/Mobile: Restore original structure
          else {
            col3.style.display = '';
            allProjects.forEach(project => {
              const originalParent = originalColumns.get(project);
              if (originalParent && project.parentElement !== originalParent) {
                originalParent.appendChild(project);
              }
            });
          }
        }

        // Run on load and resize
        redistributeProjects();
        let resizeTimer;
        window.addEventListener('resize', function() {
          clearTimeout(resizeTimer);
          resizeTimer = setTimeout(redistributeProjects, 100);
        });
      });

    </script>

